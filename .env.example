# ===========================================
# Precogly Environment Configuration
# ===========================================
# Copy this file to .env and update values.
# DO NOT commit .env to version control.
# ===========================================

# ---- Database ----
POSTGRES_DB=precogly
POSTGRES_USER=precogly
POSTGRES_PASSWORD=precogly_dev_password

# ---- Django ----
SECRET_KEY=django-insecure-dev-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://precogly:precogly_dev_password@db:5432/precogly
DJANGO_SETTINGS_MODULE=config.settings.development

# ---- CORS ----
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost

# ---- Frontend ----
FRONTEND_URL=http://localhost:5173

# ---- AI Threat Suggestions (BYOM) ----
# The AI feature is OFF by default. Set AI_SUGGESTIONS_ENABLED=True and point
# AI_BASE_URL at any OpenAI-compatible chat-completions endpoint to enable it.
# Works with GSA USAi, LM Studio, Ollama (with OpenAI compat), OpenAI, etc.
#
# Local model (LM Studio / Ollama):
# AI_SUGGESTIONS_ENABLED=True
# AI_BASE_URL=http://localhost:1234/v1
# AI_MODEL=local-model
# AI_API_KEY=
# AI_REQUEST_TIMEOUT=60
#
# GSA USAi (OpenAI-compatible; use a vision-capable model such as claude-opus-4-7 for DFD generation):
# AI_SUGGESTIONS_ENABLED=True
# AI_BASE_URL=https://api.usai.gsa.gov/v1
# AI_MODEL=claude-opus-4-7
# AI_API_KEY=<paste-usai-key-here>
# AI_REQUEST_TIMEOUT=60
#
# Required in production when organizations store their own API keys via the UI
# (development sets a local default automatically).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# AI_SECRET_KEY=
